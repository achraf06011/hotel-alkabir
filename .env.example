# =============================================
# Hotel Alkabir - Environment Variables
# =============================================
# Copy this file to .env.local and fill in the values

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32  OR  https://generate-secret.vercel.app/32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here-minimum-32-chars"

# ─── Google OAuth (Optional) ─────────────────────────────────────────────────
# Get from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Supabase Storage (for image uploads) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── Email (Optional - for notifications) ─────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Hotel Alkabir <no-reply@hotelalkabir.com>"

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_HOTEL_NAME="Hotel Alkabir"
NEXT_PUBLIC_HOTEL_PHONE="+212 5XX-XXXXXX"
NEXT_PUBLIC_HOTEL_EMAIL="contact@hotelalkabir.com"
NEXT_PUBLIC_HOTEL_ADDRESS="Avenue Mohammed V, Casablanca 20000, Maroc"
